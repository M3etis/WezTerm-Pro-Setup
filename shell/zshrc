# ~/.zshrc — managed by WezTerm-Pro-Setup
# Re-run install.sh to refresh. Manual edits are fine; re-install overwrites this file.

# ── Paths ─────────────────────────────────────────────────────────────
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

# ── oh-my-zsh ─────────────────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"

# Robbyrussell (default). To use Powerlevel10k instead, uncomment:
#   ZSH_THEME="powerlevel10k/powerlevel10k"
ZSH_THEME="robbyrussell"

plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
)

# Powerlevel10k instant prompt (only when that theme is active)
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

[[ -f "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

# Powerlevel10k config wizard (if present and theme is p10k)
[[ -f "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"

# ── Tools ─────────────────────────────────────────────────────────────
# zoxide — smarter cd
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# eza — modern ls
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons=auto'
  alias ll='eza -l --icons=auto'
  alias la='eza -la --icons=auto'
  alias lt='eza --tree --icons=auto'
  alias l='eza --icons=auto'
fi

# ── Aliases ───────────────────────────────────────────────────────────
# Coding
alias ys='yarn start'
alias yi='yarn install'
alias ns='npm start'
alias ni='npm install'

# Fast navigation
alias cdp='cd  ~/projects'
alias cdd='cd ~/documents'
alias cds='cd ~/sites'
alias cdl='cd ~/downloads'
alias cda='cd ~/applications/'

# Jump back n directories at a time
alias ..='cd ..'
alias ...='cd ../../'
alias ....='cd ../../../'
alias .....='cd ../../../../'
alias ......='cd ../../../../../'

# To clear terminal
alias c='clear'

# To exit terminal
alias x='exit'
alias q='exit'

# ENV configs
alias e.hosts='edit /etc/hosts'
alias e.httpd='edit /etc/apache2/httpd.conf'
alias e.php='edit /etc/php.ini'
alias e.vhosts='edit /etc/apache2/extra/httpd-vhosts.conf'
alias e.config='antigravity ~/.zshrc'
alias e.source='source ~/.zshrc'

# Git commands
alias ga='git add'
alias gc='git add . && git add -A && git commit -m'
alias gl='git log'
alias gs='git status'
alias gd='git diff'
alias gdc='git diff --cached'
alias gm='git commit -m'
alias gma='git commit -am'
alias gco='git checkout'
alias gra='git remote add'
alias grr='git remote rm'

alias pull='git pull'
alias push='git push'
alias clone='git clone'
alias branch='git branch'
alias fetch='git fetch'
